<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Bookstore API Test Suite" parallel="methods" thread-count="3">
    <listeners>
        <listener class-name="com.apitest.utils.TestListener"/>
        <listener class-name="com.apitest.utils.CustomReportListener"/>
    </listeners>
    <test name="Books API Tests">
        <classes>
            <class name="com.apitest.tests.BooksApiTest"/>
        </classes>
    </test>
    <test name="Authors API Tests">
        <classes>
            <class name="com.apitest.tests.AuthorsApiTest"/>
        </classes>
    </test>

</suite>